    {
      "id": "vscode-mateocerquetella-xcode-12-theme-xcode-low-key-light",
      "label": "Xcode Low Key (Light)",
      "path": "themes/xcode-low-key-light.json",
      "uiTheme": "vs"
    },
    {
      "id": "vscode-mateocerquetella-xcode-12-theme-xcode-spartan-light",
      "label": "Xcode Spartan (Light)",
      "path": "themes/xcode-spartan-light.json",
