  "name": "Matrixish-C64GreenDieOldSchool",
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#008822"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#80FF80"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#90FF90"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.language"
      ],
      "settings": {
        "foreground": "#B0FFB0"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#C0FFC0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "support.method"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#A0FFA0"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#D0FFD0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#98FF98"
      }
    },
    {
      "scope": [
        "punctuation.definition",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#88EE88"
      }
    },
    {
      "scope": [
        "meta.tag",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A8FFA8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#C8FFC8"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff4444"
      }
    }
  ],
  "type": "dark"
}