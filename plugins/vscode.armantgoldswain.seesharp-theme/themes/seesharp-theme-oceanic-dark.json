  "focusBorder": "ON",
  "name": "SeeSharp Theme - Oceanic Dark",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": [
        "comment markup.link",
        "comment",
        "punctuation.definition.comment",
        "unused.comment",
        "wildcard.comment"
      ],
      "settings": {
        "fontStyle": "italic underline",
        "foreground": "#8D8D8D"
      }
    },
    {
      "scope": [
        "text",
        "source"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#E6457B"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "underline italic",
        "foreground": "#99611F"
      }
    },
    {
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "fontStyle": "underline italic",
        "foreground": "#E6457B"
      }
    },
    {
      "scope": [
        "variable.language.self",
        "entity.type.enum",
        "variable.other.object.property",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#FF9243"
      }
    },
    {
      "scope": [
        "entity.name.type"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FE2149"
      }
    },
    {
      "scope": [
        "keyword.operator.accessor",
        "entity.name.tag.class.jsx",
        "JSXNested"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#50BCFF"
      }
    },
    {
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#fe395d"
      }
    },
    {
      "scope": [
        "keyword.other.special-method",
        "entity.name.other.preprocessor.macro",
        "variable.other.event"
