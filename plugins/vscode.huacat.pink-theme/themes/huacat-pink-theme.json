  "name": "Pink Theme",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Global settings",
      "settings": {
        "foreground": "#72696f"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#dd71b9"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#978c94"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "foreground": "#e2b213"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#e2b213"
      }
    },
    {
      "name": "Java Import & Package",
      "scope": [
        "source.java storage.modifier.import",
        "source.java storage.modifier.package",
        "meta.embedded.block.java storage.modifier.import",
        "meta.embedded.block.java storage.modifier.package"
      ],
      "settings": {
        "foreground": "#e2b213"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#a770db"
      }
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#e45d1e"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5782df"
      }
    },
    {
      "name": "Other Keywords (ex. import)",
      "scope": [
        "keyword.other",
        "source.python keyword.control.import.python"
