  "name": "word-dark-theme-old",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a5a5a5"
      }
    },
    {
      "name": "Comments: Preprocessor",
      "scope": "comment.block.preprocessor",
      "settings": {
        "fontStyle": "",
        "foreground": "#a5a5a5"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#4472c4"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#4472c4"
      }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#8064a2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#5b9bd5"
      }
    },
    {
      "name": "Function Call",
      "scope": "source.python meta.function-call.generic.python",
      "settings": {
        "foreground": "#5b9bd5"
      }
    },
    {
      "name": "Python Builtin Function",
      "scope": "source.python support.function.builtin.python",
      "settings": {
        "foreground": "#8eaadb"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "foreground": "#70ad47"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#70ad47"
      }
    },
    {
      "name": "Java Import & Package",
      "scope": [
        "source.java storage.modifier.import",
        "source.java storage.modifier.package",
        "meta.embedded.block.java storage.modifier.import",
        "meta.embedded.block.java storage.modifier.package"
      ],
      "settings": {
        "foreground": "#70ad47"
      }
    },
    {
      "name": "Numbers, Characters",
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.language",
        "constant"
      ],
      "settings": {
        "foreground": "#ffd965"
      }
    },
    {
      "name": "Other Keywords (ex. import)",
      "scope": [
        "keyword.other",
        "source.python keyword.control.import.python"
      ],
      "settings": {
        "foreground": "#ffd965"
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#ed7d31"
      }
    },
    {
      "name": "Strings: Escape Sequences",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#f4b183"
      }
    },
    {
      "name": "Strings: Regular Expressions",
      "scope": "string.regexp",
      "settings": {
        "foreground": "#f4b183"
      }
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#b2a1c7"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition.string.end.c",
        "punctuation.definition.string.begin.c",
        "punctuation.definition.string.end.cpp",
        "punctuation.definition.string.begin.cpp"
      ],
      "settings": {
        "foreground": "#4472c4"
      }
    },
    {
      "name": "HTML: Doctype Declaration",
      "scope": [
        "meta.tag.sgml.doctype",
        "meta.tag.sgml.doctype string",
        "meta.tag.sgml.doctype entity.name.tag",
        "meta.tag.sgml punctuation.definition.tag.html"
      ],
      "settings": {
        "foreground": "#a5a5a5"
      }
    },
    {
      "name": "HTML: Tags",
      "scope": [
        "meta.tag",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
      ],
      "settings": {
        "foreground": "#4472c4"
      }
    },
    {
      "name": "HTML: Tag Names",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#5b9bd5"
      }
    },
    {
      "name": "HTML: Attribute Names",
      "scope": [
        "meta.tag entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#70ad47"
      }
    },
    {
      "name": "CSS: Classes",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#a8d08d"
      }
    },
    {
      "name": "CSS: Ids",
      "scope": [
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#8064a2"
      }
    },
    {
      "name": "CSS: Tags",
      "scope": [
        "meta.selector",
        "meta.selector entity",
        "meta.selector entity punctuation",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#5b9bd5"
      }
    },
    {
      "name": "CSS: Value",
      "scope": [
        "support.constant"
      ],
      "settings": {
        "foreground": "#b2a1c7"
      }
    },
    {
      "name": "CSS: Property Names",
      "scope": [
        "meta.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#70ad47"
      }
    },
    {
