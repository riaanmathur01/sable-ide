  "name": "Geode Amethyst Crystal",
  "semanticClass": "theme.geode-amethyst.crystal",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "bold",
      "foreground": "#2AC3DE"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#5C6085"
    },
    "decorator": "#D4A0E8",
    "enum": "#2AC3DE",
    "enumMember": "#E0AF68",
    "function": "#7AA2F7",
    "function.defaultLibrary": "#7AA2F7",
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2AC3DE"
    },
    "keyword": "#A78BDB",
    "macro": "#D4A0E8",
    "method": "#7AA2F7",
    "namespace": "#2AC3DE",
    "number": "#D4A0E8",
    "operator": "#A78BDB",
    "parameter": {
      "fontStyle": "italic",
      "foreground": "#E0AF68"
    },
    "property": "#9AA0C5",
    "property.readonly": "#E0AF68",
    "regexp": "#CCA9FF",
    "string": "#73DACA",
    "type": {
      "fontStyle": "italic",
      "foreground": "#2AC3DE"
    },
    "typeParameter": "#E0AF68",
    "variable": "#C0CAF5",
    "variable.defaultLibrary": "#CCA9FF",
    "variable.readonly": "#E0AF68"
  },
  "tokenColors": [
    {
      "scope": [
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "header"
      ],
      "settings": {
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Comments (Slate)",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5C6085"
      }
    },
    {
      "name": "JSDoc keywords (Kunzite)",
      "scope": [
        "comment keyword.codetag.notation",
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#D4A0E8"
      }
    },
    {
      "name": "JSDoc types (Aquamarine)",
      "scope": [
        "comment.block.documentation variable.other",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2AC3DE"
      }
    },
    {
      "name": "Strings (Emerald)",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#73DACA"
      }
    },
    {
      "name": "String quotes (Malachite)",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#4DBDAC"
      }
    },
    {
      "name": "Template string punctuation (Crystal)",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Template string interpolation (Quartz)",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#C0CAF5"
      }
    },
    {
      "name": "Constants (Topaz)",
      "scope": [
        "constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E0AF68"
      }
    },
    {
      "name": "Numbers (Kunzite)",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D4A0E8"
      }
    },
    {
      "name": "Boolean (Facet)",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#CCA9FF"
      }
    },
    {
      "name": "Null/Undefined (Facet)",
      "scope": [
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#CCA9FF"
      }
    },
    {
      "name": "Keywords (Crystal)",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Storage keywords (Crystal)",
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Control keywords (Crystal)",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Import/Export (Crystal)",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Function names (Sapphire)",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7AA2F7"
      }
    },
    {
      "name": "Function parameters (Topaz)",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#E0AF68"
      }
    },
    {
      "name": "Arrow functions (Crystal)",
      "scope": [
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Classes (Aquamarine)",
      "scope": [
        "entity.name.type.class",
        "entity.name.class"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2AC3DE"
      }
    },
    {
      "name": "Interfaces (Aquamarine)",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2AC3DE"
      }
    },
    {
      "name": "Types (Aquamarine)",
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2AC3DE"
      }
    },
    {
      "name": "Type parameters (Topaz)",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#E0AF68"
      }
    },
    {
      "name": "Variables (Quartz)",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#C0CAF5"
      }
    },
    {
      "name": "Language variables (Facet)",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#CCA9FF"
      }
    },
    {
      "name": "Object properties (Moonstone)",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#9AA0C5"
      }
    },
    {
      "name": "HTML tags (Crystal)",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "HTML attributes (Topaz)",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#E0AF68"
      }
    },
    {
      "name": "HTML attribute values (Emerald)",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#73DACA"
      }
    },
    {
      "name": "CSS selectors (Aquamarine)",
      "scope": [
        "meta.selector",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#2AC3DE"
      }
    },
    {
      "name": "CSS properties (Sapphire)",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#7AA2F7"
      }
    },
    {
      "name": "CSS values (Topaz)",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#E0AF68"
      }
    },
    {
      "name": "CSS units (Kunzite)",
      "scope": [
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#D4A0E8"
      }
    },
    {
      "name": "CSS pseudo (Crystal)",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Operators (Crystal)",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Comparison operators (Aquamarine)",
      "scope": [
        "keyword.operator.comparison",
        "keyword.operator.relational"
      ],
      "settings": {
        "foreground": "#2AC3DE"
      }
    },
    {
      "name": "Logical operators (Crystal)",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#A78BDB"
      }
    },
    {
      "name": "Punctuation (Moonstone)",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9AA0C5"
      }
    },
    {
      "name": "Brackets (Moonstone)",
      "scope": [
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9AA0C5"
      }
    },
    {
      "name": "RegExp (Facet)",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#CCA9FF"
      }
    },
    {
      "name": "RegExp groups (Kunzite)",
      "scope": [
        "punctuation.definition.group.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#D4A0E8"
      }
    },
    {
      "name": "Decorators/Annotations (Kunzite)",
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#D4A0E8"
      }
    },
    {
      "name": "Markdown headings (Crystal)",
      "scope": [
        "markup.heading",
        "heading.1.markdown",
        "heading.2.markdown",
        "heading.3.markdown"
      ],
      "settings": {
