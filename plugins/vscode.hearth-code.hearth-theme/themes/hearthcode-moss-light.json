  "name": "Moss Light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "italic",
      "foreground": "#237296"
    },
    "decorator": {
      "fontStyle": "italic",
      "foreground": "#8c4c02"
    },
    "enum": {
      "fontStyle": "italic",
      "foreground": "#237296"
    },
    "enumMember": "#1768a6",
    "function": "#3e752b",
    "function.defaultLibrary": "#3e752b",
    "interface": {
      "fontStyle": "italic",
      "foreground": "#237296"
    },
    "keyword": {
      "fontStyle": "bold",
      "foreground": "#83640f"
    },
    "method": "#0e7963",
    "method.defaultLibrary": "#0e7963",
    "namespace": "#4f3b1e",
    "parameter": "#554a43",
    "property": "#46703f",
    "property.readonly": "#994f00",
    "type": {
      "fontStyle": "italic",
      "foreground": "#237296"
    },
    "type.defaultLibrary": {
      "fontStyle": "italic",
      "foreground": "#237296"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#237296"
    },
    "variable": "#46423d",
    "variable.defaultLibrary": "#8c4c02",
    "variable.readonly": "#994f00"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7f766a"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#83640f"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#5f5c57"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.js entity.name.function.js",
        "meta.function-call.ts entity.name.function.ts",
        "meta.function-call.py entity.name.function.py",
        "meta.function-call.python entity.name.function.python",
        "meta.function-call.go entity.name.function.go",
        "meta.function-call.rust entity.name.function.rust"
      ],
      "settings": {
        "foreground": "#3e752b"
      }
    },
    {
      "scope": [
        "meta.method-call entity.name.function",
        "meta.method-call.js entity.name.function.js",
        "meta.method-call.ts entity.name.function.ts",
        "meta.method-call.py entity.name.function.py",
        "meta.method-call.python entity.name.function.python",
        "meta.method-call.go entity.name.function.go",
        "meta.method-call.rust entity.name.function.rust"
      ],
      "settings": {
        "foreground": "#0e7963"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#3e752b"
      }
    },
    {
      "scope": [
        "entity.name.function.member",
        "entity.name.function.member.python",
        "entity.name.function.member.go",
        "entity.name.function.member.rust"
      ],
      "settings": {
        "foreground": "#0e7963"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "meta.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#46703f"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7e5a2a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#1768a6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "storage.type.java",
        "storage.type.primitive.java",
        "entity.name.struct.rust",
        "entity.name.type.class",
        "support.type",
        "support.type.builtin",
        "support.class"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#237296"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#46423d"
      }
    },
    {
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#80441b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#0067c5"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#5f6b24"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8c4c02"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#935e79"
      }
    },
    {
      "scope": [
        "constant.other.color",
        "support.constant"
      ],
      "settings": {
        "foreground": "#1768a6"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7a4500"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#a2251d"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#914b00"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#007301"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#007301"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#b53616"
      }
    },
    {
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#b53616"
      }
    }
  ],
  "type": "light"
}