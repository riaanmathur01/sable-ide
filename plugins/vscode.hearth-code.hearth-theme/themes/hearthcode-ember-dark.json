  "name": "Ember Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "italic",
      "foreground": "#99904c"
    },
    "decorator": {
      "fontStyle": "italic",
      "foreground": "#caa46c"
    },
    "enum": {
      "fontStyle": "italic",
      "foreground": "#99904c"
    },
    "enumMember": "#aa7a94",
    "function": "#6f94a4",
    "function.defaultLibrary": "#6f94a4",
    "interface": {
      "fontStyle": "italic",
      "foreground": "#99904c"
    },
    "keyword": {
      "fontStyle": "bold",
      "foreground": "#ca5b41"
    },
    "method": "#ad6a45",
    "method.defaultLibrary": "#ad6a45",
    "namespace": "#d6cab4",
    "parameter": "#c0b5a3",
    "property": "#788058",
    "property.readonly": "#c89254",
    "type": {
      "fontStyle": "italic",
      "foreground": "#99904c"
    },
    "type.defaultLibrary": {
      "fontStyle": "italic",
      "foreground": "#99904c"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#99904c"
    },
    "variable": "#c3bfb9",
    "variable.defaultLibrary": "#caa46c",
    "variable.readonly": "#c89254"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#756958"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ca5b41"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#9c978f"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.js entity.name.function.js",
        "meta.function-call.ts entity.name.function.ts",
        "meta.function-call.py entity.name.function.py",
        "meta.function-call.python entity.name.function.python",
        "meta.function-call.go entity.name.function.go",
        "meta.function-call.rust entity.name.function.rust"
      ],
      "settings": {
        "foreground": "#6f94a4"
      }
    },
    {
      "scope": [
        "meta.method-call entity.name.function",
        "meta.method-call.js entity.name.function.js",
        "meta.method-call.ts entity.name.function.ts",
        "meta.method-call.py entity.name.function.py",
        "meta.method-call.python entity.name.function.python",
        "meta.method-call.go entity.name.function.go",
        "meta.method-call.rust entity.name.function.rust"
      ],
      "settings": {
        "foreground": "#ad6a45"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#6f94a4"
      }
    },
    {
      "scope": [
        "entity.name.function.member",
        "entity.name.function.member.python",
        "entity.name.function.member.go",
        "entity.name.function.member.rust"
      ],
      "settings": {
        "foreground": "#ad6a45"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "meta.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#788058"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#c39b69"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#aa7a94"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "storage.type.java",
        "storage.type.primitive.java",
        "entity.name.struct.rust",
        "entity.name.type.class",
        "support.type",
        "support.type.builtin",
        "support.class"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#99904c"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#c3bfb9"
      }
    },
    {
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#b7774f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5ea2c4"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#af513b"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#caa46c"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#a29663"
      }
    },
    {
      "scope": [
        "constant.other.color",
        "support.constant"
      ],
      "settings": {
        "foreground": "#aa7a94"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#e1ba73"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#c26f59"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c89254"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#8fbd79"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8fbd79"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#ca8364"
      }
    },
    {
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#ca8364"
      }
    }
  ],
  "type": "dark"
}