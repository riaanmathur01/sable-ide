  "name": "Ember Light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "italic",
      "foreground": "#736a18"
    },
    "decorator": {
      "fontStyle": "italic",
      "foreground": "#8a4700"
    },
    "enum": {
      "fontStyle": "italic",
      "foreground": "#736a18"
    },
    "enumMember": "#8d5e75",
    "function": "#2e6f8f",
    "function.defaultLibrary": "#2e6f8f",
    "interface": {
      "fontStyle": "italic",
      "foreground": "#736a18"
    },
    "keyword": {
      "fontStyle": "bold",
      "foreground": "#b6442f"
    },
    "method": "#a46746",
    "method.defaultLibrary": "#a46746",
    "namespace": "#705533",
    "parameter": "#5a4431",
    "property": "#5c6447",
    "property.readonly": "#914300",
    "type": {
      "fontStyle": "italic",
      "foreground": "#736a18"
    },
    "type.defaultLibrary": {
      "fontStyle": "italic",
      "foreground": "#736a18"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#736a18"
    },
    "variable": "#4a453f",
    "variable.defaultLibrary": "#8a4700",
    "variable.readonly": "#914300"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#83776d"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#b6442f"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#64675f"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.js entity.name.function.js",
        "meta.function-call.ts entity.name.function.ts",
        "meta.function-call.py entity.name.function.py",
        "meta.function-call.python entity.name.function.python",
        "meta.function-call.go entity.name.function.go",
        "meta.function-call.rust entity.name.function.rust"
      ],
      "settings": {
        "foreground": "#2e6f8f"
      }
    },
    {
      "scope": [
        "meta.method-call entity.name.function",
        "meta.method-call.js entity.name.function.js",
        "meta.method-call.ts entity.name.function.ts",
        "meta.method-call.py entity.name.function.py",
        "meta.method-call.python entity.name.function.python",
        "meta.method-call.go entity.name.function.go",
        "meta.method-call.rust entity.name.function.rust"
      ],
      "settings": {
        "foreground": "#a46746"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#2e6f8f"
      }
    },
    {
      "scope": [
        "entity.name.function.member",
        "entity.name.function.member.python",
        "entity.name.function.member.go",
        "entity.name.function.member.rust"
      ],
      "settings": {
        "foreground": "#a46746"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "meta.property-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#5c6447"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7a4f21"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#8d5e75"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "storage.type.java",
        "storage.type.primitive.java",
        "entity.name.struct.rust",
        "entity.name.type.class",
        "support.type",
        "support.type.builtin",
        "support.class"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#736a18"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#4a453f"
      }
    },
    {
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#894c20"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#005bbb"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#77291e"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8a4700"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8c804a"
      }
    },
    {
      "scope": [
        "constant.other.color",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8d5e75"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#854d00"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#b02d21"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8d4600"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#006b00"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#006b00"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#ad2402"
      }
    },
    {
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#ad2402"
      }
    }
  ],
  "type": "light"
}