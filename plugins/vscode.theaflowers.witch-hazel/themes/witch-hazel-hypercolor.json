  "name": "Witch Hazel",
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#BFBFBF"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#81EEFF"
      }
    },
    {
      "scope": "constant.character.format.placeholder, constant.other.placeholder, meta.fstring.python variable",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FFA3C3"
      }
    },
    {
      "scope": "constant.numeric, keyword.other.unit.hexadecimal, constant.numeric.hex, storage.type.number",
      "settings": {
        "foreground": "#FFF9A3"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#C5A3FF"
      }
    },
    {
      "scope": "constant.character, constant.other, entity.name.function.preprocessor",
      "settings": {
