  },
  "name": "Aurora Nocturne",
  "semanticClass": "theme.aurora-nocturne",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": [
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "header"
      ],
      "settings": {
        "foreground": "#00f5d4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7a8cb0"
      }
    },
    {
      "name": "JSDoc keywords",
      "scope": [
        "comment keyword.codetag.notation",
        "comment.block.documentation keyword"
      ],
      "settings": {
        "foreground": "#b8c8e0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#00f5d4"
      }
    },
    {
      "name": "String quotes",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#5dade2"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#f0f8ff"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d16ba5"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8a2be2"
      }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#5dade2"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b8c8e0"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type.class",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#f0f8ff"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "storage.type"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8a2be2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#e8f4ff"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#d16ba5"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#8a2be2"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5dade2"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "meta.selector"
      ],
      "settings": {
        "foreground": "#00f5d4"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#5dade2"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#d16ba5"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#b8c8e0"
      }
    },
    {
      "name": "RegExp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f0f8ff"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#00f5d4"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f0f8ff"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b8c8e0"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#5dade2"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#8a2be2"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#d16ba5"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#7a8cb0"
      }
    }
  ]
}