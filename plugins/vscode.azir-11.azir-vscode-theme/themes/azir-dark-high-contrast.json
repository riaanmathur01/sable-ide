  "name": "GitHub Dark High Contrast",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#9babbf"
      }
    },
    {
      "scope": [
        "string",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#4da0ff"
      }
    },
    {
      "scope": [
        "constant.other.placeholder",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f48b8d"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.enummember",
        "variable.language",
        "entity"
      ],
      "settings": {
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": [
        "entity.name",
        "meta.export.default",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#f6b06a"
      }
    },
    {
      "scope": [
        "variable.parameter.function",
        "meta.jsx.children",
        "meta.block",
        "meta.tag.attributes",
        "entity.name.constant",
        "meta.object.member",
        "meta.embedded.expression"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#f7794b"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#75d36f"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#1fbdb2"
      }
    },
    {
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#f7adab"
      }
    },
    {
      "scope": [
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#99e090"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "keyword.control.conditional.vue"
      ],
      "settings": {
        "foreground": "#a3d3ff"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#a3d3ff"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#a3d3ff"
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        "foreground": "#a3d3ff"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "variable.other",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable"
      ],
      "settings": {
        "foreground": "#75d36f"
      }
    },
    {
      "scope": [
        "meta.attribute.class.html"
      ],
      "settings": {
        "foreground": "#f6b06a"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f9c1be"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f9c1be"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f9c1be"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f9c1be"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "background": "#f7adab",
        "content": "^M",
        "fontStyle": "italic underline",
        "foreground": "#c4cfde"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#f9c1be"
      }
    },
    {
      "scope": [
        "source.regexp",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a3d3ff"
      }
    },
    {
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#a3d3ff"
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#99e090"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#f7adab"
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#f6b06a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#99e090"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "background": "#f9c1be",
        "foreground": "#f7adab"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#f48b8d"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "background": "#99e090",
        "foreground": "#99e090"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "background": "#f6b06a",
        "foreground": "#f6b06a"
      }
    },
    {
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "background": "#85c2ff",
        "foreground": "#b3c0d1"
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#d2affd"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": [
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ],
      "settings": {
        "foreground": "#9babbf"
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#f7adab"
      }
    },
    {
      "scope": [
        "constant.other.reference.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#85c2ff"
      }
    }
  ]
}