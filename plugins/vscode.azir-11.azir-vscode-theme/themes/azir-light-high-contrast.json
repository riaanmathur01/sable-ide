  "name": "GitHub Light High Contrast",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#647182"
      }
    },
    {
      "scope": [
        "string",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#004db3"
      }
    },
    {
      "scope": [
        "constant.other.placeholder",
        "constant.character"
      ],
      "settings": {
        "foreground": "#df0c24"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.enummember",
        "variable.language",
        "entity"
      ],
      "settings": {
        "foreground": "#006edb"
      }
    },
    {
      "scope": [
        "entity.name",
        "meta.export.default",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#b8500f"
      }
    },
    {
      "scope": [
        "variable.parameter.function",
        "meta.jsx.children",
        "meta.block",
        "meta.tag.attributes",
        "entity.name.constant",
        "meta.object.member",
        "meta.embedded.expression"
      ],
      "settings": {
        "foreground": "#010409"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#946a00"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#946a00"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#946a00"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#894ceb"
      }
    },
    {
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#df0c24"
      }
    },
    {
      "scope": [
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#2c8141"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "keyword.control.conditional.vue"
      ],
      "settings": {
        "foreground": "#006edb"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#010409"
      }
    },
    {
      "scope": [
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#002b75"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#002b75"
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        "foreground": "#002b75"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "variable.other",
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#010409"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable"
      ],
      "settings": {
        "foreground": "#31bf46"
      }
    },
    {
      "scope": [
        "meta.attribute.class.html"
      ],
      "settings": {
        "foreground": "#b8500f"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#610a20"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#610a20"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#610a20"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#610a20"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "background": "#df0c24",
        "content": "^M",
        "fontStyle": "italic underline",
        "foreground": "#303031"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#df0c24"
      }
    },
    {
      "scope": [
        "source.regexp",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#002b75"
      }
    },
    {
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#006edb"
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2c8141"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#006edb"
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#006edb"
      }
    },
    {
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#df0c24"
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#006edb"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#b8500f"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#006edb"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#2c8141"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#010409"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#010409"
      }
    },
    {
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#006edb"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "background": "#df0c24",
        "foreground": "#df0c24"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#df0c24"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "background": "#2c8141",
        "foreground": "#2c8141"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "background": "#b8500f",
        "foreground": "#b8500f"
      }
    },
    {
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "background": "#003d99",
        "foreground": "#424448"
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#894ceb"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#006edb"
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#006edb"
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#006edb"
      }
    },
    {
      "scope": [
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ],
      "settings": {
        "foreground": "#647182"
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#df0c24"
      }
    },
    {
      "scope": [
        "constant.other.reference.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#006edb"
      }
    }
  ]
}