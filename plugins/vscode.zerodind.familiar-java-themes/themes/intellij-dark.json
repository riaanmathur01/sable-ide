  "semanticHighlighting": true,
  "semanticTokenColors": {
    "*.constructor.declaration:java": "#FFC66D",
    "*.documentation": {
      "fontStyle": "italic"
    },
    "*:java": {
      "fontStyle": "",
      "foreground": "#A9B7C6"
    },
    "annotation:java": "#BBB529",
    "enumMember:java": {
      "fontStyle": "italic",
      "foreground": "#9876AA"
    },
    "function.declaration:java": {
      "fontStyle": "",
      "foreground": "#FFC66D"
    },
    "function.static:java": {
      "fontStyle": "italic"
    },
    "keyword.documentation:java": {
      "fontStyle": "italic bold underline",
      "foreground": "#629755"
    },
    "keyword:java": "#CC7832",
    "method.declaration:java": {
      "fontStyle": "",
      "foreground": "#FFC66D"
    },
    "method.static:java": {
      "fontStyle": "italic"
    },
    "modifier:java": "#CC7832",
    "parameter.documentation": "#8A653B",
    "property.static:java": {
      "fontStyle": "italic"
    },
    "property:java": "#9876AA",
    "typeParameter:java": "#507874"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "scope": [
        "comment.block.javadoc.java",
        "comment.line.number-sign.yaml"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#629755"
      }
    },
    {
      "scope": [
        "keyword.other.documentation.javadoc.java"
      ],
      "settings": {
        "fontStyle": "italic bold underline",
        "foreground": "#629755"
      }
    },
    {
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown",
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.string.end.markdown"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#287BDE"
      }
    },
    {
      "scope": [
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FFC66D"
      }
    },
    {
      "scope": [
        "markup.inline.raw.string.markdown",
        "markup.fenced_code.block.markdown",
        "string.other.link.description.title.markdown",
        "punctuation.separator.key-value.java-properties"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.localname.xml",
        "entity.other.attribute-name.xml",
        "variable.language.documentroot.xml"
      ],
      "settings": {
        "foreground": "#BABABA"
      }
    },
    {
      "scope": [
        "entity.name.tag.localname.xml",
        "entity.name.tag.xml",
        "keyword.other.doctype.xml",
        "punctuation.definition.tag.xml"
      ],
      "settings": {
        "foreground": "#E8BF6A"
      }
    },
    {
      "scope": [
        "constant.character.entity.xml"
      ],
      "settings": {
        "foreground": "#6D9CBE"
      }
    },
    {
      "scope": [
        "entity.name.type.class.java",
        "entity.name.type.enum.java",
        "entity.other.inherited-class.java",
        "storage.type.java",
        "variable.other.object.java",
        "storage.type.generic.java",
        "storage.type.object.array.java",
        "variable.other.definition.java",
        "entity.name.function.java",
        "meta.embedded.block",
        "source.editorconfig punctuation.definition.brace",
        "source.editorconfig keyword.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.namespace.xml",
        "entity.other.attribute-name.namespace.xml",
        "source.editorconfig keyword.other.definition"
      ],
      "settings": {
        "foreground": "#9876AA"
      }
    },
    {
      "scope": [
        "constant.other.enum.java",
        "markup.heading.markdown",
        "markup.heading.setext.1.markdown",
        "markup.heading.setext.2.markdown"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#9876AA"
      }
    },
    {
      "scope": [
        "punctuation.definition.annotation.java",
        "storage.type.annotation.java"
      ],
      "settings": {
        "foreground": "#BBB529"
      }
    },
    {
      "scope": [
        "comment.block.javadoc.java variable.parameter.java"
      ],
      "settings": {
        "foreground": "#8A653B"
      }
    },
    {
      "scope": [
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.dictionary.pair.json",
        "constant.language.json",
        "entity.name.tag.yaml",
        "punctuation.definition.bold.markdown",
        "punctuation.definition.italic.markdown",
        "punctuation.definition.constant.markdown",
        "punctuation.definition.constant.begin.markdown",
        "punctuation.definition.constant.end.markdown",
        "constant.other.reference.link.markdown",
        "storage.modifier.java",
        "storage.modifier.extends.java",
        "storage.modifier.super.java",
        "storage.modifier.implements.java",
        "storage.type.primitive.java",
        "storage.type.primitive.array.java",
        "constant.language.java",
        "keyword.other.import.java",
        "keyword.other.package.java",
        "keyword.control.java",
        "keyword.control.new.java",
        "keyword.control.try.java",
        "keyword.control.catch.java",
        "keyword.control.finally.java",
        "keyword.control.throw.java",
        "keyword.operator.instanceof.java",
        "variable.language.java",
        "variable.language.this.java",
        "variable.other.object.property.java",
        "punctuation.separator.delimiter.java",
        "punctuation.terminator.java",
        "constant.character.escape",
        "entity.name.section.group-title.editorconfig",
        "support.constant.java-properties"
      ],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#6897BB"
      }
    },
    {
      "scope": [
        "string.quoted.double",
        "string.quoted.single",
        "markup.quote.markdown",
        "source.editorconfig constant.language",
        "source.editorconfig constant.numeric",
        "string.unquoted.java-properties"
      ],
      "settings": {
        "foreground": "#6A8759"
      }
    }
  ]
}