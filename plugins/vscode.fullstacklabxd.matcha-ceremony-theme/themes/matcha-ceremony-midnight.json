  "name": "Matcha Ceremony Midnight",
  "semanticClass": "theme.matcha-ceremony-midnight",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "bold",
      "foreground": "#7BA3A3"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#6B6357"
    },
    "decorator": "#B8A9C9",
    "enum": "#7BA3A3",
    "enumMember": "#C9B896",
    "function": "#8FA8A0",
    "function.defaultLibrary": "#8FA8A0",
    "interface": {
      "fontStyle": "italic",
      "foreground": "#7BA3A3"
    },
    "keyword": "#7D9B76",
    "macro": "#B8A9C9",
    "method": "#8FA8A0",
    "namespace": "#7BA3A3",
    "number": "#B8A9C9",
    "operator": "#7D9B76",
    "parameter": {
      "fontStyle": "italic",
      "foreground": "#C9B896"
    },
    "property": "#A89F8B",
    "property.readonly": "#C9B896",
    "regexp": "#A4C49B",
    "string": "#E8DCC4",
    "type": {
      "fontStyle": "italic",
      "foreground": "#7BA3A3"
    },
    "typeParameter": "#C9B896",
    "variable": "#EDE8DC",
    "variable.defaultLibrary": "#A4C49B",
    "variable.readonly": "#C9B896"
  },
  "tokenColors": [
    {
      "scope": [
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "header"
      ],
      "settings": {
        "foreground": "#7D9B76"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6B6357"
      }
    },
    {
      "name": "JSDoc keywords",
      "scope": [
        "comment keyword.codetag.notation",
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#B8A9C9"
      }
    },
    {
      "name": "JSDoc types",
      "scope": [
        "comment.block.documentation variable.other",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7BA3A3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#E8DCC4"
      }
    },
    {
      "name": "String quotes",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#D4C4A8"
      }
    },
    {
      "name": "Template string punctuation",
