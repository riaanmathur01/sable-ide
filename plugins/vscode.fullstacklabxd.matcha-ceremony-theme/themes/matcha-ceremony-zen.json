  "name": "Matcha Ceremony Zen",
  "semanticClass": "theme.matcha-ceremony-zen",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "bold",
      "foreground": "#6A8A8A"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#5A544D"
    },
    "decorator": "#9A8CA8",
    "enum": "#6A8A8A",
    "enumMember": "#B0A080",
    "function": "#7A9189",
    "function.defaultLibrary": "#7A9189",
    "interface": {
      "fontStyle": "italic",
      "foreground": "#6A8A8A"
    },
    "keyword": "#6D8A66",
    "macro": "#9A8CA8",
    "method": "#7A9189",
    "namespace": "#6A8A8A",
    "number": "#9A8CA8",
    "operator": "#6D8A66",
    "parameter": {
      "fontStyle": "italic",
      "foreground": "#B0A080"
    },
    "property": "#8A8579",
    "property.readonly": "#B0A080",
    "regexp": "#8BA382",
    "string": "#D0C5B5",
    "type": {
      "fontStyle": "italic",
      "foreground": "#6A8A8A"
    },
    "typeParameter": "#B0A080",
    "variable": "#D5D0C5",
    "variable.defaultLibrary": "#8BA382",
    "variable.readonly": "#B0A080"
  },
  "tokenColors": [
    {
      "scope": [
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "header"
      ],
      "settings": {
        "foreground": "#6D8A66"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5A544D"
      }
    },
    {
      "name": "JSDoc keywords",
      "scope": [
        "comment keyword.codetag.notation",
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#9A8CA8"
      }
    },
    {
      "name": "JSDoc types",
      "scope": [
        "comment.block.documentation variable.other",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6A8A8A"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#D0C5B5"
      }
    },
    {
      "name": "String quotes",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#C0B5A5"
      }
    },
    {
      "name": "Template string punctuation",
