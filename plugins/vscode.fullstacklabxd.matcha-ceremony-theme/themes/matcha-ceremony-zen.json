      "settings": {
        "foreground": "#6D8A66"
      }
    },
    {
      "name": "Template string interpolation",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#D5D0C5"
      }
    },
    {
      "name": "Constants",
