    "terminal.ansiBrightRed": "#f07a70",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.ansiBrightYellow": "#f0bb02",
    "terminal.ansiCyan": "#24b6ca",
    "terminal.ansiGreen": "#5ca85c",
    "terminal.ansiMagenta": "#9a42ac",
