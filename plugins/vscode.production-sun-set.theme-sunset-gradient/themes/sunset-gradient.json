    "terminal.ansiBlue": "#42a5f5",
    "terminal.ansiBrightBlack": "#4a2c5a",
    "terminal.ansiBrightBlue": "#64b5f6",
    "terminal.ansiBrightCyan": "#4dd0e1",
    "terminal.ansiBrightGreen": "#81c784",
    "terminal.ansiBrightMagenta": "#ce93d8",
    "terminal.ansiBrightRed": "#ff8a80",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.ansiBrightYellow": "#ffcc02",
    "terminal.ansiCyan": "#26c6da",
    "terminal.ansiGreen": "#66bb6a",
    "terminal.ansiMagenta": "#ab47bc",
    "terminal.ansiRed": "#ff6b6b",
    "terminal.ansiWhite": "#fff3e0",
    "terminal.ansiYellow": "#ffa726",
    "terminal.background": "#2d1b3d",
    "terminal.foreground": "#fff3e0",
    "titleBar.activeBackground": "#241530",
    "titleBar.activeForeground": "#fff3e0",
    "titleBar.inactiveBackground": "#1a0f1f",
    "titleBar.inactiveForeground": "#8e7cc3"
  },
  "name": "Sunset Gradient",
  "semanticClass": "theme.sunset-gradient",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": [
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "header"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8e7cc3"
      }
    },
    {
      "name": "JSDoc keywords",
      "scope": [
        "comment keyword.codetag.notation",
        "comment.block.documentation keyword"
      ],
      "settings": {
        "foreground": "#b39ddb"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#ffcc02"
      }
    },
    {
      "name": "String quotes",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#ffa726"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ce93d8"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ab47bc"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#ffa726"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ffcc02"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type.class",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#42a5f5"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "storage.type"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#64b5f6"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#fff3e0"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff8a80"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ffa726"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "meta.selector"
      ],
      "settings": {
        "foreground": "#42a5f5"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#26c6da"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ff8a80"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#b39ddb"
      }
    },
    {
      "name": "RegExp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#66bb6a"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ffa726"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ab47bc"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#42a5f5"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#ffcc02"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#ff5252"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#8e7cc3"
      }
    }
  ]
}