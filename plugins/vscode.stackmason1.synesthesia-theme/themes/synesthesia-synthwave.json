  "name": "Synesthesia Synthwave",
  "semanticClass": "theme.synesthesia",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "bold",
      "foreground": "#89DDFF"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#676E95"
    },
    "decorator": "#C792EA",
    "enum": "#89DDFF",
    "enumMember": "#FFCB6B",
    "function": "#82AAFF",
    "function.defaultLibrary": "#82AAFF",
    "interface": {
      "fontStyle": "italic",
      "foreground": "#89DDFF"
    },
    "keyword": "#FF6AC1",
    "macro": "#C792EA",
    "method": "#82AAFF",
    "namespace": "#89DDFF",
    "number": "#C792EA",
    "operator": "#FF6AC1",
    "parameter": {
      "fontStyle": "italic",
      "foreground": "#FFCB6B"
    },
    "property": "#A6ACCD",
    "property.readonly": "#FFCB6B",
    "regexp": "#FF9AC1",
    "string": "#72F1B8",
    "type": {
      "fontStyle": "italic",
      "foreground": "#89DDFF"
    },
    "typeParameter": "#FFCB6B",
    "variable": "#E4F0FB",
    "variable.defaultLibrary": "#FF9AC1",
    "variable.readonly": "#FFCB6B"
  },
  "tokenColors": [
    {
      "scope": [
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "header"
      ],
      "settings": {
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#676E95"
      }
    },
    {
      "name": "JSDoc keywords",
      "scope": [
        "comment keyword.codetag.notation",
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "JSDoc types",
      "scope": [
        "comment.block.documentation variable.other",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#72F1B8"
      }
    },
    {
      "name": "String quotes",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#4CD4A0"
      }
    },
    {
      "name": "Template string punctuation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Template string interpolation",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#E4F0FB"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#FF9AC1"
      }
    },
    {
      "name": "Null/Undefined",
      "scope": [
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FF9AC1"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Storage keywords",
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Control keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "Arrow functions",
      "scope": [
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type.class",
        "entity.name.class"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#E4F0FB"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FF9AC1"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#A6ACCD"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "HTML attribute values",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#72F1B8"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "meta.selector",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "CSS units",
      "scope": [
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "CSS pseudo",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Comparison operators",
      "scope": [
        "keyword.operator.comparison",
        "keyword.operator.relational"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Logical operators",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#A6ACCD"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#A6ACCD"
      }
    },
    {
      "name": "RegExp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FF9AC1"
      }
    },
    {
      "name": "RegExp groups",
      "scope": [
        "punctuation.definition.group.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Decorators/Annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "heading.1.markdown",
        "heading.2.markdown",
        "heading.3.markdown"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FF6AC1"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#C792EA"
      }
