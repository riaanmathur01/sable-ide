{
  "author": "Hondry Travis",
  "colors": {
    "activityBar.background": "#F8F1E3",
    "activityBar.border": "#EBE4D5",
    "activityBar.foreground": "#202124",
    "activityBarBadge.background": "#005393",
    "agentsChatInput.border": "#EBE4D5",
    "editor.background": "#FAF5E8",
