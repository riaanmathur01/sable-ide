    "editorWidget.border": "#EBE4D5",
    "focusBorder": "#155dbd",
    "gitDecoration.addedResourceForeground": "#00753B",
    "gitDecoration.deletedResourceForeground": "#B71C1C",
    "gitDecoration.modifiedResourceForeground": "#006F94",
    "input.background": "#F3ECDE",
    "input.border": "#EBE4D5",
    "list.activeSelectionBackground": "#EBE4D5",
    "list.activeSelectionForeground": "#202124",
    "list.errorForeground": "#B71C1C",
    "list.focusAndSelectionOutline": "#005393",
    "list.hoverBackground": "#EBE4D5",
    "list.inactiveSelectionBackground": "#EBE4D5",
    "list.warningForeground": "#B71C1C",
    "minimap.findMatchHighlight": "#00753B",
    "panel.border": "#EBE4D5",
    "panelTitle.activeBorder": "#005393",
    "sideBar.background": "#FAF5E8",
    "sideBar.border": "#EBE4D5",
    "sideBarSectionHeader.background": "#F3ECDE",
    "sideBarTitle.foreground": "#202124",
    "statusBar.background": "#FAF5E8",
    "statusBar.border": "#EBE4D5",
    "statusBar.foreground": "#202124",
    "statusBar.noFolderBackground": "#FAF5E8",
    "tab.activeBackground": "#FAF5E8",
    "tab.activeBorder": "#FAF5E8",
    "tab.activeBorderTop": "#005393",
    "tab.border": "#EBE4D5",
    "tab.inactiveBackground": "#F0E8D8",
    "terminal.background": "#FAF5E8",
    "titleBar.activeBackground": "#F8F1E3",
    "titleBar.border": "#EBE4D5",
    "titleBar.inactiveBackground": "#FAF5E8",
    "widget.border": "#EBE4D5"
  },
  "maintainers": "travis<Hondry.Travis@outlook.com>",
  "name": "Simple Light Soft",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#3c4043"
      }
    },
    {
      "name": "Variables this ...",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#8020D0"
      }
    },
    {
      "name": "Variables parameter ...",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#BC5000"
      }
    },
    {
      "name": "Variables constant ...",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#1B1F23"
      }
    },
    {
      "name": "Variables Less Sass ...",
      "scope": [
        "variable.scss",
        "variable.other.interpolation.less"
      ],
      "settings": {
        "foreground": "#1B1F23"
      }
    },
    {
      "name": "Variables parameter for C#",
      "scope": [
        "entity.name.variable.parameter.cs"
      ],
      "settings": {
        "foreground": "#BC5000"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a0a1a7"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B71C1C"
      }
    },
    {
      "name": "Invalid: HTML[attribute-name]",
      "scope": [
        "invalid.deprecated.entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#005393"
      }
    },
    {
      "name": "Invalid: Style[attribute-name]",
      "scope": [
        "invalid.deprecated.media"
      ],
      "settings": {
        "foreground": "#00753B"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Keyword: new",
      "scope": [
        "keyword.operator.new"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword: use for [C#/.Net] type",
      "scope": [
        "keyword.type.cs"
      ],
      "settings": {
        "foreground": "#006F94"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Storage: Type for c#",
      "scope": [
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#005393"
      }
    },
    {
      "name": "MarkDown - paragraph",
      "scope": [
        "meta.paragraph.markdown",
        "text.html.markdown"
      ],
      "settings": {
        "foreground": "#5f6368"
      }
    },
    {
      "name": "MarkDown - heading",
      "scope": [
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "MarkDown - heading content",
      "scope": [
        "markup.heading.markdown"
      ],
      "settings": {
        "foreground": "#005393"
      }
    },
    {
      "name": "MarkDown - code mark",
      "scope": [
        "punctuation.definition.markdown",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#1967d2"
      }
    },
    {
      "name": "MarkDown - raw code mark",
      "scope": [
        "punctuation.definition.raw.markdown",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#1967d2"
      }
    },
    {
      "name": "MarkDown - underline",
      "scope": [
        "markup.underline.link.markdown"
      ],
      "settings": {
        "foreground": "#1967d2"
      }
    },
    {
      "name": "MarkDown - inline underline",
      "scope": [
        "meta.link.inline.markdown"
      ],
      "settings": {
        "foreground": "#BC5000"
      }
    },
    {
      "name": "MarkDown - bold",
      "scope": [
        "punctuation.definition.bold.markdown",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#BC5000"
      }
    },
    {
      "name": "MarkDown - list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list.unnumbered.markdown"
      ],
      "settings": {
        "foreground": "#BC5000"
      }
    },
    {
      "name": "MarkDown - image",
      "scope": [
        "punctuation.definition.string.begin.markdown"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "MarkDown - image - link",
      "scope": [
        "markup.underline.link.image.markdown"
      ],
      "settings": {
        "foreground": "#1967d2"
      }
    },
    {
      "name": "MarkDown - image - description",
      "scope": [
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#6A1B9A"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#8020D0"
      }
    },
    {
      "name": "Entity: Attribute Name",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#005393"
      }
    },
    {
      "name": "Entity: Css[hover...] ...",
      "scope": [
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Entity: TagName",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Entity: Native-Object[Array,Object]",
      "scope": [
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#005393"
      }
    },
    {
      "name": "Entity: use for C++/C",
      "scope": [
        "entity.name.namespace.cpp",
        "entity.name.namespace.c"
      ],
      "settings": {
        "foreground": "#006F94"
      }
    },
    {
      "name": "Meta: Color of Function name",
      "scope": [
        "meta.function.parameters",
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#00753B"
      }
    },
    {
      "name": "Meta: Use for in HTML attr id",
      "scope": [
        "meta.toc-list.id.html",
        "meta.attribute-with-value.id"
      ],
      "settings": {
        "foreground": "#2e7d32"
      }
    },
    {
      "name": "Meta: Use for in HTML @",
      "scope": [
        "meta.tag.block.any"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Meta: Use for in CSS unit rpx",
      "scope": [
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#8020D0"
      }
    },
    {
      "name": "String: Quoted | Template",
      "scope": [
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.quoted.other",
        "string.template"
      ],
      "settings": {
        "foreground": "#a31515"
      }
    },
    {
      "name": "String: Regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#00753B"
      }
    },
    {
      "name": "String-Attribute: CSS",
      "scope": [
        "string.unquoted.attribute-value.css"
      ],
      "settings": {
        "foreground": "#8020D0"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.separator.continuation",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#3c4043"
      }
    },
    {
      "name": "Punctuation: color at the start and end of string",
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end",
        "punctuation.definition.string.template.begin",
        "punctuation.definition.string.template.end"
      ],
      "settings": {
        "foreground": "#a31515"
      }
    },
    {
      "name": "Punctuation: JSON color",
      "scope": [
        "string.json",
        "punctuation.support.type.property-name.begin",
        "punctuation.support.type.property-name.end",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#006F94"
      }
    },
    {
      "name": "Punctuation: Escape character",
      "scope": [
        "punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#8020D0"
      }
    },
    {
      "name": "Punctuation: Use for jsdoc comment",
      "scope": [
        "punctuation.definition.block.tag.jsdoc",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Punctuation: Use for jsdoc comment",
      "scope": [
        "punctuation.definition.bracket.curly.begin.jsdoc",
        "punctuation.definition.bracket.curly.end.jsdoc"
      ],
      "settings": {
        "foreground": "#BC5000"
      }
    },
    {
      "name": "Punctuation: use for less,css,sass,html",
      "scope": [
        "punctuation.separator.key-value",
        "punctuation.definition.variable",
        "punctuation.definition.keyword",
        "punctuation.definition.entity.css",
        "punctuation.definition.constant.css",
        "punctuation.definition.interpolation",
        "keyword.control.at-rule.import",
        "variable.other.less"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Punctuation: use for React tsx/jsx/ts [?.] ...",
      "scope": [
        "punctuation.accessor.optional"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Punctuation: use for C++/C",
      "scope": [
        "punctuation.definition.directive.cpp",
        "punctuation.definition.directive.c"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Punctuation: use for markdown [] symbol",
      "scope": [
        "punctuation.definition.string.end.markdown",
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.metadata.markdown"
      ],
      "settings": {
        "foreground": "#d01884"
      }
    },
    {
      "name": "Support",
      "scope": [
        "support.class",
        "support.variable",
        "support.function",
        "support.type",
        "support.constant"
      ],
      "settings": {
        "foreground": "#006F94"
      }
    },
    {
      "name": "Support CSS",
      "scope": [
        "support.constant.color.w3c-standard-color-name.css",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#8020D0"
      }
    }
  ],
  "type": "dark"
}