    {
      "id": "vscode-astechlabs-cc-theme-clay-terminal-high-contrast",
      "label": "Clay Terminal High Contrast",
      "path": "themes/clay-terminal-high-contrast.json",
      "uiTheme": "hc-black"
    },
    {
      "id": "vscode-astechlabs-cc-theme-clay-terminal-light-high-contrast",
      "label": "Clay Terminal Light High Contrast",
      "path": "themes/clay-terminal-light-high-contrast.json",
      "uiTheme": "hc-light"
    }
  ],
  "version": "0.8.1"
