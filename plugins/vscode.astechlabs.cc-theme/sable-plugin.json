{
  "author": "astechlabs",
  "description": "A warm dark/light VS Code theme with a coral terminal-inspired accent.",
  "homepage": "https://github.com/MadhuS-1605/clay-terminal",
  "id": "vscode.astechlabs.cc-theme",
  "minSableVersion": "0.3.8",
  "name": "Clay Terminal",
  "permissions": [],
  "themes": [
    {
      "id": "vscode-astechlabs-cc-theme-clay-terminal",
      "label": "Clay Terminal",
      "path": "themes/clay-terminal.json",
      "uiTheme": "vs-dark"
    },
    {
      "id": "vscode-astechlabs-cc-theme-clay-terminal-light",
      "label": "Clay Terminal Light",
      "path": "themes/clay-terminal-light.json",
