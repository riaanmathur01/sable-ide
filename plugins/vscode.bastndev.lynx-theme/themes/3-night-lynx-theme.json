  "name": "Lynx Night Theme",
  "semanticClass": "lynx-night-theme",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "bold",
      "foreground": "#2db8b0"
    },
    "decorator": {
      "fontStyle": "bold",
      "foreground": "#6aaedd"
    },
    "enum": {
      "fontStyle": "bold",
      "foreground": "#d4a83a"
    },
    "enumMember": {
      "fontStyle": "bold",
      "foreground": "#3de070"
    },
    "event": {
      "fontStyle": "italic",
      "foreground": "#f07075"
    },
    "function": {
      "fontStyle": "bold",
      "foreground": "#2db8b0"
    },
    "interface": {
      "fontStyle": "bold italic",
      "foreground": "#3dd8ce"
    },
    "label": {
      "foreground": "#e87850"
    },
    "macro": {
      "fontStyle": "bold italic",
      "foreground": "#c898e8"
    },
    "method": {
      "fontStyle": "bold",
      "foreground": "#3dd8ce"
    },
    "namespace": {
      "fontStyle": "italic",
      "foreground": "#e87850"
    },
    "parameter": {
      "fontStyle": "italic",
      "foreground": "#e07850"
    },
    "property": "#6aaedd",
    "property.readonly": {
      "fontStyle": "italic",
      "foreground": "#6aaedd"
    },
    "struct": {
      "fontStyle": "bold",
      "foreground": "#2db8b0"
    },
    "type": {
      "fontStyle": "bold",
      "foreground": "#2ab8b0"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#c898e8"
    },
    "variable": "#98bcc0",
    "variable.defaultLibrary": {
      "fontStyle": "bold",
      "foreground": "#3de070"
    },
    "variable.readonly": {
      "fontStyle": "italic",
      "foreground": "#6aaedd"
    }
  },
  "tokenColors": [
    {
      "name": "Comment — Line",
      "scope": [
        "comment.line",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2e5060"
      }
    },
    {
      "name": "Comment — Block",
      "scope": "comment.block",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2e5060"
      }
    },
    {
      "name": "Comment — Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic bold",
        "foreground": "#3a6070"
      }
    },
    {
      "name": "Astro String Quoted",
      "scope": [
        "string.quoted.astro"
      ],
      "settings": {
        "foreground": "#2db8b0"
      }
    },
    {
      "name": "Astro Source",
      "scope": [
        "source.astro"
      ],
      "settings": {
        "foreground": "#ddeef0"
      }
    },
    {
      "name": "Keywords Control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#e87850"
      }
    },
    {
      "name": "Keywords Control Flow",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#e87850"
      }
    },
    {
      "name": "Keywords Control New",
      "scope": [
        "keyword.control.new",
        "keyword.operator.new"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f07075"
      }
    },
    {
      "name": "Keywords Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#8aaab0"
      }
    },
    {
      "name": "Keywords Async/Await",
      "scope": [
        "keyword.control.async",
        "keyword.control.await"
      ],
      "settings": {
