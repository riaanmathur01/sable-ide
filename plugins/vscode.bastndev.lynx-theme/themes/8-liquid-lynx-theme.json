  "name": "Lynx Liquid Glass",
  "semanticClass": "theme.liquid-glass",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "#86e1cb"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#4a7090"
    },
    "decorator": {
      "foreground": "#9888f8"
    },
    "enum": {
      "foreground": "#e0af68"
    },
    "enumMember": {
      "foreground": "#e0af68"
    },
    "function": {
      "foreground": "#73daca"
    },
    "interface": {
      "foreground": "#7aa2f7"
    },
    "keyword": {
      "fontStyle": "bold",
      "foreground": "#bb9af7"
    },
    "label": {
      "foreground": "#e0af68"
    },
    "macro": {
      "foreground": "#bb9af7"
    },
    "method": {
      "foreground": "#7dcfff"
    },
    "namespace": {
      "foreground": "#7aa2f7"
    },
    "number": {
      "foreground": "#bb9af7"
    },
    "parameter": {
      "foreground": "#ffaabb"
    },
    "property": {
      "foreground": "#7dcfff"
    },
    "property.readonly": {
      "foreground": "#5ab0d8"
    },
    "regexp": {
      "foreground": "#ff8080"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#bb9af7"
    },
    "string": {
      "foreground": "#9ece6a"
    },
    "struct": {
      "foreground": "#86e1cb"
    },
    "type": {
      "foreground": "#86e1cb"
    },
    "typeParameter": {
      "foreground": "#bb9af7"
    },
    "variable": {
      "foreground": "#c0caf5"
    },
    "variable.readonly": {
      "foreground": "#bb9af7"
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4a7090"
      }
    },
    {
      "name": "Comment — TODO / FIXME / NOTE",
      "scope": [
        "comment.line.todo",
        "comment.line.fixme",
        "keyword.codetag.notation"
      ],
      "settings": {
        "fontStyle": "bold italic",
        "foreground": "#e0af68"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "Template Literals",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "Template Expression Braces",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type.class",
        "storage.type.function",
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.namespace"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "Storage Modifiers",
      "scope": [
        "storage.modifier",
        "keyword.control.as",
        "keyword.control.from",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#ff80b8"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "Arithmetic & Comparison Operators",
      "scope": [
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#73daca"
      }
    },
    {
      "name": "Function Calls",
      "scope": [
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#86e1cb"
      }
    },
    {
      "name": "Type Annotations & Generics",
      "scope": [
        "meta.type.annotation",
        "entity.name.type.alias",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "support.type"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "Variables — Constant / Readonly",
      "scope": [
        "variable.other.constant",
        "variable.other.declaration",
        "support.variable.property.const"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "Object Properties",
      "scope": [
        "variable.object.property",
        "meta.object.member",
        "support.variable.property",
        "meta.property.object"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "Constants — Numeric",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "Constants — Language",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "Constants — Other",
      "scope": [
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "Character Escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff8080"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ff8080"
      }
    },
    {
      "name": "Regex — Group / Quantifier",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "punctuation.definition.group.regexp",
        "keyword.operator.or.regexp"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "HTML / XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "HTML / XML Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "HTML — Attribute Values",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "CSS — Selector Element",
      "scope": [
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "CSS — Property",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "CSS — Property Value / Function",
      "scope": [
        "support.function.transform.css",
        "support.constant.property-value.css",
        "constant.other.color.rgb-value.css",
        "support.function.misc.css"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "CSS — Units",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "JSON — Keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "Markdown — Heading",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "Markdown — Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "Markdown — Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#d0c8f0"
      }
    },
    {
      "name": "Markdown — Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "Markdown — Link",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "Markdown — Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4a7090"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#4a6070"
      }
    },
    {
      "name": "Punctuation — Brackets",
      "scope": [
        "punctuation.section.block",
        "punctuation.definition.block",
        "meta.brace.square",
        "meta.brace.round"
      ],
      "settings": {
        "foreground": "#7090a8"
      }
    },
    {
      "name": "Decorator / Annotation",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#9888f8"
      }
    },
    {
      "name": "this / self / super",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#e0af68"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#f7768e"
      }
    }
  ],
  "type": "dark"
}