  "name": "Lynx Kiro Theme",
  "semanticClass": "lynx-kiro-theme",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "bold",
      "foreground": "#a78bfa"
    },
    "decorator": {
      "fontStyle": "bold",
      "foreground": "#56b6f7"
    },
    "enum": {
      "fontStyle": "bold",
      "foreground": "#e8c547"
    },
    "enumMember": {
      "fontStyle": "bold",
      "foreground": "#7c3aed"
    },
    "event": {
      "fontStyle": "italic",
      "foreground": "#f07080"
    },
    "function": {
      "fontStyle": "bold",
      "foreground": "#56b6f7"
    },
    "interface": {
      "fontStyle": "bold italic",
      "foreground": "#56b6f7"
    },
    "label": {
      "foreground": "#e8c547"
    },
    "macro": {
      "fontStyle": "bold italic",
      "foreground": "#c4a8ff"
    },
    "method": {
      "fontStyle": "bold",
      "foreground": "#56b6f7"
    },
    "namespace": {
      "fontStyle": "italic",
      "foreground": "#e8c547"
    },
    "parameter": {
      "fontStyle": "italic",
      "foreground": "#f0a8c8"
    },
    "property": "#5dd8a8",
    "property.readonly": {
      "fontStyle": "italic",
      "foreground": "#5dd8a8"
    },
    "struct": {
      "fontStyle": "bold",
      "foreground": "#a78bfa"
    },
    "type": {
      "fontStyle": "bold",
      "foreground": "#c082f0"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#c4a8ff"
    },
    "variable": "#e0daf0",
    "variable.defaultLibrary": {
      "fontStyle": "bold",
      "foreground": "#7c3aed"
    },
    "variable.readonly": {
      "fontStyle": "italic",
      "foreground": "#5dd8a8"
    }
  },
  "tokenColors": [
    {
      "name": "Comment — Line",
      "scope": [
        "comment.line",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4e4462"
      }
    },
    {
      "name": "Comment — Block",
      "scope": "comment.block",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4e4462"
      }
    },
    {
      "name": "Comment — Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic bold",
        "foreground": "#615878"
      }
    },
    {
      "name": "Astro String Quoted",
      "scope": [
        "string.quoted.astro"
      ],
      "settings": {
        "foreground": "#40d4b8"
      }
    },
    {
      "name": "Astro Source",
      "scope": [
        "source.astro"
      ],
      "settings": {
        "foreground": "#e8e3f0"
      }
    },
    {
      "name": "Keywords Control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#d0b0ff"
      }
    },
    {
      "name": "Keywords Control Flow",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#b888fa"
      }
    },
    {
      "name": "Keywords Control New",
      "scope": [
        "keyword.control.new",
        "keyword.operator.new"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f07080"
      }
    },
    {
      "name": "Keywords Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
