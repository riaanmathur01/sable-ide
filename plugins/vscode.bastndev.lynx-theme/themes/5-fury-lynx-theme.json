  "name": "Lynx fury Theme",
  "semanticClass": "lynx-fury-theme",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "bold",
      "foreground": "#D4607A"
    },
    "decorator": {
      "fontStyle": "bold",
      "foreground": "#C4547A"
    },
    "enum": {
      "fontStyle": "bold",
      "foreground": "#FF7A00"
    },
    "enumMember": {
      "fontStyle": "bold",
      "foreground": "#FFB300"
    },
    "event": {
      "fontStyle": "italic",
      "foreground": "#C4547A"
    },
    "function": {
      "fontStyle": "bold",
      "foreground": "#F3B23D"
    },
    "interface": {
      "fontStyle": "bold italic",
      "foreground": "#D4607A"
    },
    "label": {
      "foreground": "#ff8a1d"
    },
    "macro": {
      "fontStyle": "bold italic",
      "foreground": "#ff8a1d"
    },
    "method": {
      "fontStyle": "bold",
      "foreground": "#F3B23D"
    },
    "namespace": {
      "fontStyle": "italic",
      "foreground": "#FF7A00"
    },
    "parameter": {
      "fontStyle": "italic",
      "foreground": "#FFB300"
    },
    "property": "#FFD54F",
    "property.readonly": {
      "fontStyle": "italic",
      "foreground": "#FFD54F"
    },
    "struct": {
      "fontStyle": "bold",
      "foreground": "#D4607A"
    },
    "type": {
      "fontStyle": "bold",
      "foreground": "#D4607A"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#FF9D00"
    },
    "variable": "#FFF3E0",
    "variable.defaultLibrary": {
      "fontStyle": "bold",
      "foreground": "#C4547A"
    },
    "variable.readonly": {
      "fontStyle": "italic",
      "foreground": "#FFF3E0"
    }
  },
  "tokenColors": [
    {
      "name": "Comment — Line",
      "scope": [
        "comment.line",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6D6D6D"
      }
    },
    {
      "name": "Comment — Block",
      "scope": "comment.block",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6D6D6D"
      }
    },
    {
      "name": "Comment — Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6D6D6D"
      }
    },
    {
      "name": "Astro String Quoted",
      "scope": [
        "string.quoted.astro"
      ],
      "settings": {
        "foreground": "#88C0D0"
      }
    },
    {
      "name": "Astro Source",
      "scope": [
        "source.astro"
      ],
      "settings": {
        "foreground": "#81A1C1"
      }
    },
    {
      "name": "Keywords Control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#D87093"
      }
    },
    {
      "name": "Keywords Control Flow",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#D87093"
      }
    },
    {
      "name": "Keywords Control New",
      "scope": [
        "keyword.control.new",
        "keyword.operator.new"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#E07A8A"
      }
    },
    {
      "name": "Keywords Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#E07A8A"
      }
    },
    {
      "name": "Keywords Async/Await",
      "scope": [
        "keyword.control.async",
        "keyword.control.await"
      ],
      "settings": {
        "fontStyle": "bold italic",
        "foreground": "#B48EAD"
      }
    },
