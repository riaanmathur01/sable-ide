  "name": "Lynx Ghibli Theme",
  "semanticClass": "lynx-ghibli-theme",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "bold",
      "foreground": "#8b7865"
    },
    "decorator": {
      "fontStyle": "bold",
      "foreground": "#8250df"
    },
    "enum": {
      "fontStyle": "bold",
      "foreground": "#c4a373"
    },
    "enumMember": {
      "fontStyle": "bold",
      "foreground": "#c4a373"
    },
    "event": {
      "fontStyle": "italic",
      "foreground": "#b5836a"
    },
    "function": {
      "fontStyle": "bold",
      "foreground": "#8250df"
    },
    "interface": {
      "fontStyle": "bold italic",
      "foreground": "#b19b7d"
    },
    "label": {
      "foreground": "#c4a373"
    },
    "macro": {
      "fontStyle": "bold italic",
      "foreground": "#8250df"
    },
    "method": {
      "fontStyle": "bold",
      "foreground": "#8250df"
    },
    "namespace": {
      "fontStyle": "italic",
      "foreground": "#c4a373"
    },
    "parameter": {
      "fontStyle": "italic",
      "foreground": "#b5836a"
    },
    "property": "#718ba7",
    "property.readonly": {
      "fontStyle": "italic",
      "foreground": "#718ba7"
    },
    "struct": {
      "fontStyle": "bold",
      "foreground": "#6b5d4f"
    },
    "type": {
      "fontStyle": "bold",
      "foreground": "#4a3f35"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#a0927f"
    },
    "variable": "#718ba7",
    "variable.defaultLibrary": {
      "fontStyle": "bold",
      "foreground": "#c4a373"
    },
    "variable.readonly": {
      "fontStyle": "italic",
      "foreground": "#718ba7"
    }
  },
  "tokenColors": [
    {
      "name": "Comment — Line",
      "scope": [
        "comment.line",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#9a8b7a"
      }
    },
    {
      "name": "Comment — Block",
      "scope": "comment.block",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#9a8b7a"
      }
    },
    {
      "name": "Comment — Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic bold",
        "foreground": "#8a7b6a"
      }
    },
    {
      "name": "Astro String Quoted",
      "scope": [
        "string.quoted.astro"
      ],
      "settings": {
        "foreground": "#23ab98"
      }
    },
    {
      "name": "Astro Source",
      "scope": [
        "source.astro"
      ],
      "settings": {
        "foreground": "#4a3f35"
      }
    },
    {
      "name": "Keywords Control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#cf222e"
      }
    },
    {
      "name": "Keywords Control Flow",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
