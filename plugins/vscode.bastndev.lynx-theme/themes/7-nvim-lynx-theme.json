  "name": "Lynx Test Theme",
  "semanticClass": "lynx-test-theme",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "fontStyle": "bold",
      "foreground": "#3b9eff"
    },
    "decorator": {
      "fontStyle": "bold",
      "foreground": "#f5a623"
    },
    "enum": {
      "fontStyle": "bold",
      "foreground": "#f5a623"
    },
    "enumMember": {
      "fontStyle": "bold",
      "foreground": "#3dd68c"
    },
    "event": {
      "fontStyle": "italic",
      "foreground": "#e060b8"
    },
    "function": {
      "fontStyle": "bold",
      "foreground": "#3b9eff"
    },
    "interface": {
      "fontStyle": "bold italic",
      "foreground": "#0090ff"
    },
    "label": {
      "foreground": "#f76b15"
    },
    "macro": {
      "fontStyle": "bold italic",
      "foreground": "#b36fe0"
    },
    "method": {
      "fontStyle": "bold",
      "foreground": "#3b9eff"
    },
    "namespace": {
      "fontStyle": "italic",
      "foreground": "#f76b15"
    },
    "parameter": {
      "fontStyle": "italic",
      "foreground": "#3dd68c"
    },
    "property": "#9aabcf",
    "property.readonly": {
      "fontStyle": "italic",
      "foreground": "#9aabcf"
    },
    "struct": {
      "fontStyle": "bold",
      "foreground": "#3b9eff"
    },
    "type": {
      "fontStyle": "bold",
      "foreground": "#3dd68c"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#b36fe0"
    },
    "variable": "#e0e2e6",
    "variable.defaultLibrary": {
      "fontStyle": "bold",
      "foreground": "#3dd68c"
    },
    "variable.readonly": {
      "fontStyle": "italic",
      "foreground": "#9aabcf"
    }
  },
  "tokenColors": [
    {
      "name": "Comment — Line",
      "scope": [
        "comment.line",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4a4f57"
      }
    },
    {
      "name": "Comment — Block",
      "scope": "comment.block",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4a4f57"
      }
    },
    {
      "name": "Comment — Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic bold",
        "foreground": "#5a606a"
      }
    },
    {
      "name": "Astro String Quoted",
      "scope": [
        "string.quoted.astro"
      ],
      "settings": {
        "foreground": "#f5a623"
      }
    },
    {
      "name": "Astro Source",
      "scope": [
        "source.astro"
      ],
      "settings": {
        "foreground": "#edeef0"
      }
    },
    {
      "name": "Keywords Control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#b36fe0"
      }
    },
    {
      "name": "Keywords Control Flow",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#de51a8"
      }
    },
    {
      "name": "Keywords Control New",
      "scope": [
        "keyword.control.new",
        "keyword.operator.new"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff5555"
      }
    },
    {
      "name": "Keywords Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#9098a0"
      }
    },
    {
      "name": "Keywords Async/Await",
      "scope": [
        "keyword.control.async",
        "keyword.control.await"
      ],
      "settings": {
        "fontStyle": "bold italic",
        "foreground": "#de51a8"
      }
    },
    {
      "name": "Keywords Other",
      "scope": [
        "keyword.other"
      ],
      "settings": {
        "foreground": "#de51a8"
      }
    },
    {
      "name": "Storage Type",
      "scope": [
        "storage.type"
      ],
      "settings": {
