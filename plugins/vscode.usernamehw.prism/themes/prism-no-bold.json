  "name": "Prism",
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8d9aa6"
      }
    },
    {
      "scope": "comment.block.preprocessor",
      "settings": {
        "fontStyle": "",
        "foreground": "#AAAAAA"
      }
    },
    {
      "scope": [
        "meta.brace.square",
        "meta.brace.round",
        "punctuation.separator.parameter"
