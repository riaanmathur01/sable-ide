{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Sable's windows",
  "windows": [
    "main",
    "window-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "opener:default"
  ]
}
